  "nodes": [
    {
      "parameters": {
        "jsCode": "const descripcion = $json.descripcion.toLowerCase();\n\nlet area_id = 1;\n\nif (descripcion.includes(\"poda\") || descripcion.includes(\"arbol\") || descripcion.includes(\"pasto\")) {\n  area_id = 1;\n} else if (descripcion.includes(\"basura\") || descripcion.includes(\"limpieza\")) {\n  area_id = 2;\n} else if (descripcion.includes(\"luz\") || descripcion.includes(\"luminaria\")) {\n  area_id = 3;\n} else if (descripcion.includes(\"pozo\") || descripcion.includes(\"bache\") || descripcion.includes(\"calle\") || descripcion.includes(\"lomo\")) {\n  area_id = 4;\n}\n\nreturn [{\n  ...$json,\n  area_id,\n  estado_id: 1\n}];"
      },
